.aider*
.env
node_modules/
concursosH2bd/concursosbd.mv.db
concursosH2bd/concursosbd.trace.db
concurso-backend/src/main/resources/static/concursosH2bd/concursosbd.trace.db

# H2 Database files
concurso-backend/data/concursosH2bd.*
*.mv.db
*.trace.db

target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# =============================================================================
# SISTEMA DE ALMACENAMIENTO UNIFICADO
# =============================================================================
# Nueva estructura unificada
storage/
!storage/.gitkeep
# Incluir archivos de bases y descripciones de concursos
!storage/contest-bases/
!storage/contest-bases/*.pdf
!storage/contest-descriptions/
!storage/contest-descriptions/*.pdf

# Carpetas legacy (mantener hasta migración completa)
document-storage/
document-storage-dev/
concurso-backend/uploads/
concurso-backend/document-storage/

# Angular
.angular/
dist/
tmp/
out-tsc/
bazel-out/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typingslogs/*.log

# =============================================================================
# ARCHIVOS DE BACKUP Y RECUPERACIÓN - SEGURIDAD CRÍTICA
# =============================================================================
# Carpetas de backup y recuperación
backups/
backup_*/
*_backup/
backup-*/
backup*/
BACKUP*/
RECOVERY*/
recovery_*/
*_recovery/
*recovery*/

# Plan de recuperación específico
RECOVERY_PLAN_DEFINITIVO/
temp_recovery_commands.*

# Archivos de backup individuales
*.backup
*.backup.*
*_backup.*
*.bak
*.sql.backup
*.tar.gz.backup
*.orig
*.old

# Backups específicos por fecha
backup_*_20*
*_backup_20*
backup_pre_*
backup_post_*

# Scripts y archivos de limpieza
cleanup_old_backups.sh
verificar-integridad-backups.*
*-checksums.md5
*checksums*.md5

# =============================================================================
# CONFIGURACIONES SENSIBLES Y CERTIFICADOS SSL
# =============================================================================
# Archivos de entorno con información sensible
.env.production
.env.ssl
.env.local
.env.development

# Configuraciones Docker sensibles
docker-compose.ssl.*
docker-compose.prod.*
docker-compose.*.backup*
docker-compose.ssl.image-template.yml
docker-compose.ssl.override.yml

# Setup y certificados SSL
ssl-setup/
certificates/
certs/
*.pem
*.key
*.crt
*.p12
*.jks

# =============================================================================
# ARCHIVOS TEMPORALES Y LOGS DE SISTEMA
# =============================================================================
# Logs de sistema
logs/
*.log
log-monitor.*

# Archivos temporales
temp/
tmp/
temporary/
*.tmp
*.temp

# Dumps de base de datos
*.sql
*.dump
backup_*.sql

# =============================================================================
# EXCLUSIONES ESPECÍFICAS DEL PROYECTO
# =============================================================================
# Scripts de monitoreo
scripts/monitor/
mpd-monitor-*

# Archivos de configuración de desarrollo local
local-config/
dev-setup/

# Archivos de prueba con datos sensibles  
test-data-sensitive/
user-test-*

# Allow example configuration files
!docker-compose.ssl.example.yml
!.env.production.example

# Archivos JAR generados
*.jar
app.jar
target/*.jar
