# Configuración SSL para MPD Concursos
# Copia este archivo a .env y configura tus valores

# Dominio principal (REQUERIDO)
DOMAIN=tu-dominio.com

# Email para Let's Encrypt (REQUERIDO)
SSL_EMAIL=tu-email@ejemplo.com

# Configuración de Base de Datos
MYSQL_ROOT_PASSWORD=root1234_secure
MYSQL_DATABASE=mpd_concursos
MYSQL_USER=mpd_user
MYSQL_PASSWORD=mpd_password_secure

# Configuración de entorno
ENVIRONMENT=production

# Configuración de logs
LOG_LEVEL=INFO
