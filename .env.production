# Variables de entorno para producción - MPD Concursos
# Servidor Donweb: vps-4778464-x.dattaweb.com (149.50.132.23)

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=mpd_concursos
MYSQL_USER=mpd_user
MYSQL_PASSWORD=mpd_password

# Configuración del servidor
SERVER_HOST=149.50.132.23
SERVER_PORT_FRONTEND=8000
SERVER_PORT_BACKEND=8080
SERVER_PORT_MYSQL=3307

# URLs de la aplicación
FRONTEND_URL=http://149.50.132.23:8000
BACKEND_URL=http://149.50.132.23:8080
API_URL=http://149.50.132.23:8080/api

# Configuración CORS
CORS_ALLOWED_ORIGINS=http://149.50.132.23:8000,https://149.50.132.23:8000

# Configuración de seguridad JWT
JWT_SECRET=mpd_concursos_jwt_secret_production_2025_very_long_and_secure_key
JWT_EXPIRATION=86400

# Configuración de almacenamiento unificado
STORAGE_BASE_DIR=/app/storage
DOCUMENT_STORAGE_PATH=/app/storage/documents
CONTEST_BASES_PATH=/app/storage/contest-bases
CV_DOCUMENTS_PATH=/app/storage/cv-documents
PROFILE_IMAGES_PATH=/app/storage/profile-images
TEMP_STORAGE_PATH=/app/storage/temp
MAX_FILE_SIZE=20971520

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs

# Configuración de base de datos
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000

# Configuración de memoria Java
JAVA_OPTS="-Xmx1g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

# Configuración de producción
SPRING_PROFILES_ACTIVE=prod
NODE_ENV=production

# Configuración de monitoreo
ENABLE_ACTUATOR=true
ACTUATOR_ENDPOINTS=health,info,metrics

# Configuración de backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# SSL Configuration for HTTPS
DOMAIN=vps-4778464-x.dattaweb.com
SSL_EMAIL=contacto@mpd.gob.ar
