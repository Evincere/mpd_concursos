<div class="inscripcion-process-container" #processContainer>
  <div class="inscripcion-header">
    <div class="header-content">
      <h1 class="page-title">Proceso de Inscripción</h1>
      <h2 class="contest-title" *ngIf="contest">{{ contest.title }}</h2>
      <app-custom-button
        variant="secondary"
        label="Volver a Concursos"
        icon="arrow-left"
        (buttonClick)="volverAConcursos()"
        ariaLabel="Volver a la lista de concursos"
        class="btn-back">
      </app-custom-button>
    </div>
  </div>

  <div class="inscripcion-content">
    <!-- Pasos de inscripción -->
    <div class="steps-container">
      <div class="step-line"></div>
      <div class="step-progress" [style.width]="progressPercentage + '%'"></div>

      <div class="step"
           *ngFor="let step of steps; let i = index"
           [class.active]="currentStep === i + 1"
           [class.completed]="currentStep > i + 1"
           [class.clickable]="currentStep > i + 1"
           (click)="goToStep(i + 1)"
           (keydown.enter)="goToStep(i + 1)"
           (keydown.space)="goToStep(i + 1); $event.preventDefault()"
           [attr.tabindex]="currentStep > i + 1 ? '0' : '-1'"
           [attr.role]="currentStep > i + 1 ? 'button' : 'presentation'"
           [attr.aria-label]="'Ir al paso ' + (i + 1) + ': ' + step.label">
        <div class="step-number">
          <i class="fas fa-check" *ngIf="currentStep > i + 1"></i>
          <span *ngIf="currentStep <= i + 1">{{i + 1}}</span>
        </div>
        <div class="step-label">{{step.label}}</div>
      </div>
    </div>

    <!-- Contenido de los pasos -->
    <div class="step-content-container" [formGroup]="inscriptionForm">
      <!-- Paso 1: Confirmación de Lectura de Bases -->
      <div class="step-content" *ngIf="currentStep === 1" @fadeInOut>
        <div class="content-section">
          <h3>Términos y Condiciones</h3>

          <!-- Contenedor de términos y condiciones -->
          <div class="terms-container" *ngIf="termsAndConditionsContent">
            <div [innerHTML]="termsAndConditionsContent"></div>
          </div>

          <h3>Confirmación de Lectura de Bases</h3>

          <div class="confirmation-question-container">
            <div class="question-box">
              <div class="question-icon">
                <i class="fas fa-question-circle"></i>
              </div>
              <div class="question-content">
                <h4>Pregunta Obligatoria</h4>
                <p class="question-text">
                  ¿Ha leído atentamente las <strong>BASES CONCURSO DE ANTECEDENTES Y OPOSICIÓN</strong>
                  y la <strong>DESCRIPCIÓN DEL PUESTO PSICOLABORAL</strong> y declara formalmente aceptar
                  los términos y condiciones impuestos, así como los requisitos formales de cada una de
                  las etapas que se explican?
                </p>
              </div>
            </div>

            <!-- Sección de documentos disponibles -->
            <div class="documents-section" *ngIf="!loadingDocumentAvailability">
              <!-- Documentos disponibles -->
              <div class="available-documents" *ngIf="hasAvailableDocuments">
                <h5 class="documents-title">
                  <i class="fas fa-file-pdf"></i>
                  Documentos Disponibles
                </h5>
                <p class="documents-description">
                  Puede consultar los siguientes documentos antes de confirmar su aceptación:
                </p>

                <div class="document-buttons">
                  <!-- Botón para ver bases -->
                  <button
                    type="button"
                    class="document-button bases-button"
                    *ngIf="contestDocumentAvailability?.basesAvailable"
                    (click)="viewContestBases()"
                    title="Ver bases del concurso en nueva pestaña">
                    <i class="fas fa-file-alt"></i>
                    <span>Ver Bases del Concurso</span>
                    <i class="fas fa-external-link-alt"></i>
                  </button>

                  <!-- Botón para ver descripción -->
                  <button
                    type="button"
                    class="document-button description-button"
                    *ngIf="contestDocumentAvailability?.descriptionAvailable"
                    (click)="viewContestDescription()"
                    title="Ver descripción del puesto en nueva pestaña">
                    <i class="fas fa-briefcase"></i>
                    <span>Ver Descripción del Puesto</span>
                    <i class="fas fa-external-link-alt"></i>
                  </button>
                </div>
              </div>

              <!-- Mensaje cuando no hay documentos disponibles -->
              <div class="documents-not-available" *ngIf="!hasAvailableDocuments">
                <div class="info-message">
                  <i class="fas fa-info-circle"></i>
                  <span>{{ documentsNotAvailableMessage }}</span>
                </div>
              </div>
            </div>

            <!-- Loading de documentos -->
            <div class="documents-loading" *ngIf="loadingDocumentAvailability">
              <div class="loading-message">
                <i class="fas fa-spinner fa-spin"></i>
                <span>Verificando disponibilidad de documentos...</span>
              </div>
            </div>

            <div class="response-options">
              <div class="radio-group">
                <div class="radio-option">
                  <input
                    type="radio"
                    id="terms-yes"
                    name="termsResponse"
                    [value]="true"
                    (change)="onTermsResponseChange(true)"
                    [checked]="termsAcceptedControl.value === true">
                  <label for="terms-yes" class="radio-label">
                    <span class="radio-button"></span>
                    <span class="radio-text">
                      <strong>Sí</strong> - He leído y acepto las bases y condiciones
                    </span>
                  </label>
                </div>

                <div class="radio-option">
                  <input
                    type="radio"
                    id="terms-no"
                    name="termsResponse"
                    [value]="false"
                    (change)="onTermsResponseChange(false)"
                    [checked]="termsAcceptedControl.value === false">
                  <label for="terms-no" class="radio-label">
                    <span class="radio-button"></span>
                    <span class="radio-text">
                      <strong>No</strong> - No he leído o no acepto las bases y condiciones
                    </span>
                  </label>
                </div>
              </div>

              <div class="validation-message" *ngIf="showValidationErrors && termsAcceptedControl.invalid">
                <i class="fas fa-exclamation-circle"></i>
                <span>Debe seleccionar "Sí" para continuar con el proceso de inscripción</span>
              </div>

              <div class="warning-message" *ngIf="termsAcceptedControl.value === false">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Para continuar con la inscripción debe leer y aceptar las bases y condiciones del concurso.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Paso 2: Centro de vida y circunscripciones -->
      <div class="step-content" *ngIf="currentStep === 2" @fadeInOut>
        <div class="content-section">
          <h3>Centro de Vida</h3>
          <p class="section-description">
            Indique su domicilio actual, el cual será considerado como su centro de vida.
            Consulte en las bases y condiciones las implicaciones del establecimiento de este domicilio.
          </p>

          <div class="address-selector-wrapper">
            <app-custom-address-autocomplete
              [label]="'Domicilio'"
              [placeholder]="'Ingrese su domicilio completo y presione Enter (ej: Emilio Civit 256, Ciudad, Mendoza)'"
              [required]="true"
              [initialValue]="centroDeVidaControl.value"
              [errorMessage]="'Por favor ingrese una dirección válida'"
              [hint]="'💡 Tip: Escriba su dirección completa y presione Enter para confirmar. Este domicilio se guardará en su perfil como su centro de vida.'"
              [province]="'Mendoza'"
              (addressSelected)="onAddressSelected($event)"
            ></app-custom-address-autocomplete>
          </div>

          <div class="info-box">
            <i class="fas fa-info-circle"></i>
            <span>Esta dirección se guardará en su perfil como su centro de vida.</span>
          </div>
        </div>

        <div class="custom-divider"></div>

        <div class="content-section">
          <h3>Circunscripciones Judiciales</h3>
          <p class="section-description">
            Seleccione las circunscripciones judiciales donde está dispuesto a trabajar.
            <strong>Esta información no podrá ser modificada con posterioridad y será utilizada para la confección del orden de mérito definitivo.</strong>
          </p>

          <div class="circunscripciones-container">
            <!-- Primera Circunscripción -->
            <div class="circunscripcion-item">
              <app-custom-checkbox
                [label]="'Primera Circunscripción'"
                [checked]="isCircunscripcionSelected('Primera')"
                (change)="onCircunscripcionChange($event, 'Primera')">
              </app-custom-checkbox>
            </div>

            <!-- Segunda Circunscripción con departamentos -->
            <div class="circunscripcion-item circunscripcion-con-departamentos">
              <app-custom-checkbox
                [label]="'Segunda Circunscripción (completa)'"
                [checked]="isCircunscripcionCompletaSelected('Segunda')"
                (change)="onCircunscripcionCompletaChange($event, 'Segunda')">
              </app-custom-checkbox>

              <!-- Departamentos de la Segunda Circunscripción -->
              <div class="departamentos-container" *ngIf="!isCircunscripcionCompletaSelected('Segunda')">
                <div class="departamentos-header">
                  <span class="departamentos-label">O seleccione departamentos específicos:</span>
                </div>
                <div class="departamentos-grid">
                  <div class="departamento-item" *ngFor="let departamento of departamentosSegundaCircunscripcion">
                    <app-custom-checkbox
                      [label]="departamento.nombre"
                      [checked]="isDepartamentoSelected('Segunda', departamento.id)"
                      (change)="onDepartamentoChange($event, 'Segunda', departamento.id)">
                    </app-custom-checkbox>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tercera Circunscripción -->
            <div class="circunscripcion-item">
              <app-custom-checkbox
                [label]="'Tercera Circunscripción'"
                [checked]="isCircunscripcionSelected('Tercera')"
                (change)="onCircunscripcionChange($event, 'Tercera')">
              </app-custom-checkbox>
            </div>

            <!-- Cuarta Circunscripción -->
            <div class="circunscripcion-item">
              <app-custom-checkbox
                [label]="'Cuarta Circunscripción'"
                [checked]="isCircunscripcionSelected('Cuarta')"
                (change)="onCircunscripcionChange($event, 'Cuarta')">
              </app-custom-checkbox>
            </div>
          </div>

          <div class="info-box">
            <i class="fas fa-info-circle"></i>
            <span>Para la Segunda Circunscripción puede seleccionar toda la circunscripción o departamentos específicos (San Rafael, General Alvear, Malargüe).</span>
          </div>

          <div class="error-message" *ngIf="selectedCircunscripcionesControl.invalid && selectedCircunscripcionesControl.touched">
            Debe seleccionar al menos una circunscripción o departamento
          </div>
        </div>
      </div>

      <!-- Paso 3: Documentación -->
      <div class="step-content" *ngIf="currentStep === 3" @fadeInOut>
        <div class="content-section">
          <h3>Documentación Requerida</h3>

          <!-- Componente de documentos embebidos -->
          <app-documentos-embebidos
            [concursoId]="getContestId()"
            (documentosCompletados)="onDocumentosCompletados($event)">
          </app-documentos-embebidos>



          <!-- ✅ CORREGIDO: Sección de inscripción provisional mejorada -->
          <div class="provisional-inscription-section" *ngIf="!shouldHideProvisionalSection()">
            <div class="provisional-alert">
              <div class="alert-header">
                <i class="fas fa-exclamation-triangle" *ngIf="!isInGracePeriod()"></i>
                <i class="fas fa-clock" *ngIf="isInGracePeriod()"></i>
                <span [style.color]="isInGracePeriod() ? '#dc2626' : '#f59e0b'">{{ getGracePeriodMessage().title }}</span>
              </div>
              <p>
                {{ getGracePeriodMessage().description }}
              </p>

              <!-- Fecha límite específica para período de regularización -->
              <div class="deadline-notice" *ngIf="isInGracePeriod()">
                <i class="fas fa-calendar-times"></i>
                <span class="deadline-text">{{ getRegularizationDeadlineMessage() }}</span>
              </div>

              <!-- Checkbox de conformidad - comportamiento diferente según el contexto -->
              <div class="provisional-acceptance">
                <app-custom-checkbox
                  formControlName="documentosCompletos"
                  [label]="getProvisionalCheckboxLabel()"
                  [disabled]="isProvisionalCheckboxDisabled()"
                  class="provisional-checkbox"
                  [class.disabled-checkbox]="isProvisionalCheckboxDisabled()">
                </app-custom-checkbox>
              </div>

              <!-- Instrucciones específicas según el contexto -->
              <div class="context-instructions">
                <div class="alert alert-info" *ngIf="!isInGracePeriod()">
                  <i class="fas fa-info-circle"></i>
                  <strong>Inscripción provisional:</strong> Podrá completar la documentación durante los 3 días hábiles posteriores al cierre de inscripciones.
                </div>
                <div class="alert alert-danger" *ngIf="isInGracePeriod()">
                  <i class="fas fa-exclamation-triangle"></i>
                  <strong>Período de regularización:</strong> Debe completar TODOS los documentos obligatorios para continuar. No podrá avanzar con documentación incompleta.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Paso 4: Confirmación -->
      <div class="step-content" *ngIf="isStep4()" @fadeInOut>
        <div class="content-section">
          <h3>Confirmación de Inscripción</h3>
          <p class="section-description">
            Por favor, revise la información proporcionada antes de finalizar su inscripción.
          </p>

          <div class="confirmation-summary">
            <!-- Información del Concurso -->
            <div class="summary-section contest-info">
              <div class="section-header">
                <i class="fas fa-trophy"></i>
                <h4>Información del Concurso</h4>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <span class="label">Concurso:</span>
                  <span class="value">{{ contest?.title }}</span>
                </div>
                <div class="info-item">
                  <span class="label">Cargo:</span>
                  <span class="value">{{ contest?.position }}</span>
                </div>
                <div class="info-item" *ngIf="contest?.description">
                  <span class="label">Descripción:</span>
                  <span class="value">{{ contest?.description }}</span>
                </div>
                <div class="info-item" *ngIf="contest?.department">
                  <span class="label">Dependencia:</span>
                  <span class="value">{{ contest?.department }}</span>
                </div>
              </div>
            </div>

            <!-- Datos Personales -->
            <div class="summary-section personal-info">
              <div class="section-header">
                <i class="fas fa-user"></i>
                <h4>Datos Personales</h4>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <span class="label">Centro de Vida:</span>
                  <span class="value">{{ getCentroDeVidaValue() }}</span>
                </div>
                <div class="info-item">
                  <span class="label">Circunscripciones Seleccionadas:</span>
                  <span class="value">{{ getSelectedCircunscripcionesValue() }}</span>
                </div>
              </div>
            </div>

            <!-- Estado de Documentación -->
            <div class="summary-section documentation-status">
              <div class="section-header">
                <i class="fas fa-file-alt"></i>
                <h4>Estado de la Documentación</h4>
                <div class="documentation-summary">
                  <span class="docs-completed">{{ getDocumentosCompletados() }}</span>
                  <span class="docs-separator">/</span>
                  <span class="docs-total">{{ documentacionRequerida.length || 0 }}</span>
                  <span class="docs-label">documentos</span>
                </div>
              </div>

              <!-- Indicador de progreso de documentación -->
              <div class="documentation-progress">
                <div class="progress-bar">
                  <div class="progress-fill" [style.width.%]="getDocumentationProgress()"></div>
                </div>
                <span class="progress-text">{{ getDocumentationProgress() }}% completado</span>
              </div>

              <!-- Lista de documentos -->
              <div class="documents-grid">
                <div class="document-status-item" *ngFor="let doc of documentacionRequerida">
                  <div class="doc-icon">
                    <i class="fas fa-file-pdf" [class.completed]="doc.completed" [class.pending]="!doc.completed"></i>
                  </div>
                  <div class="doc-info">
                    <span class="doc-title">{{ doc.title }}</span>
                    <div class="doc-status-badge" [class.completed]="doc.completed" [class.pending]="!doc.completed">
                      <i class="fas" [class.fa-check-circle]="doc.completed" [class.fa-clock]="!doc.completed"></i>
                      <span>{{ doc.completed ? 'Completado' : 'Pendiente' }}</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Información de inscripción provisional (solo informativa en el resumen) -->
              <div class="provisional-info" *ngIf="!shouldHideProvisionalSection()">
                <div class="info-header">
                  <span style="color: #f59e0b;">{{ getGracePeriodMessage().title }}</span>
                  <span style="color: #f59e0b;">{{ getGracePeriodMessage().title }}</span>
                </div>
                <p *ngIf="!isInGracePeriod()">
                  Su inscripción será registrada como <strong>provisional</strong> debido a documentación pendiente.
                  Recuerde que tiene <strong>3 días hábiles</strong> después del cierre de inscripciones para completar
                  la documentación y evitar la descalificación automática.
                </p>
                <p *ngIf="isInGracePeriod()">
                  <strong>Estado actual:</strong> Su inscripción está en período de gracia debido a documentación pendiente.
                  Debe completar la carga de todos los documentos requeridos antes del miércoles 13/08/2025 23:59
                  para evitar que su inscripción sea rechazada automáticamente.
                </p>
              </div>
            </div>
          </div>

          <div class="confirmation-checkbox">
            <app-custom-checkbox
              formControlName="confirmedPersonalData"
              label="Confirmo que todos los datos proporcionados son correctos y completos">
            </app-custom-checkbox>
          </div>
        </div>
      </div>
    </div>

    <!-- Botones de acción -->
    <div class="action-buttons button-row">
      <app-custom-button
        *ngIf="currentStep > 1"
        variant="secondary"
        label="Atrás"
        icon="arrow-left"
        (buttonClick)="previousStep()">

      <!-- NUEVO: Botón Guardar y Salir -->
      <app-custom-button
        *ngIf="shouldShowSaveAndExitButton()"
        variant="secondary"
        label="Guardar y Salir"
        icon="save"
        (buttonClick)="saveAndExit()">
      </app-custom-button>
      </app-custom-button>

      <app-custom-button
        *ngIf="currentStep < 4"
        variant="primary"
        label="Siguiente"
        icon="arrow-right"
        [disabled]="!canProceed()"
        (buttonClick)="nextStep()">
      </app-custom-button>

      <app-custom-button
        *ngIf="isStep4()"
        variant="success"
        label="Finalizar Inscripción"
        icon="check-circle"
        [disabled]="!canFinish() || loading"
        [loading]="loading"
        (buttonClick)="finish()">
      </app-custom-button>
    </div>
  </div>
</div>
