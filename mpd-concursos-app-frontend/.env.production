# Variables de entorno para producción
API_URL=/api
API_PORT=8080
FRONTEND_PORT=80
ENABLE_DEBUG_LOGS=false
ENABLE_MOCK_DATA=false
JWT_TOKEN_KEY=mpd_concursos_token
REFRESH_TOKEN_KEY=mpd_concursos_refresh_token
